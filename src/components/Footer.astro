---
import { SITE, SOCIAL_LINKS } from '@/consts'

const links = [
  { href: '/blog/', label: 'blog' },
  { href: '/about/', label: 'about' },
  { href: '/rss.xml', label: 'rss' },
  ...SOCIAL_LINKS.filter((l) => l.label !== 'Medium').map((l) => ({
    href: l.href,
    label: l.label.toLowerCase(),
  })),
]
---

<footer class="border-border border-t">
  <div
    class="text-faint mx-auto flex max-w-[1100px] flex-wrap items-center justify-between gap-4 px-4 py-7 font-mono text-xs tracking-normal sm:px-6"
  >
    <span class="flex items-center gap-2">
      <span
        class="border-faint grid size-3 place-items-center rounded-full border-[1.5px]"
        aria-hidden="true"
      >
        <span class="bg-primary size-1 rounded-full"></span>
      </span>
      &copy; {new Date().getFullYear()}
      {SITE.title}
    </span>
    <nav class="flex flex-wrap gap-[18px]" aria-label="Footer">
      {
        links.map(({ href, label }) => {
          const external = href.startsWith('http')
          return (
            <a
              href={href}
              class="hover:text-foreground transition-colors"
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              {label}
            </a>
          )
        })
      }
    </nav>
  </div>
</footer>
