---
import { cn } from '@/lib/utils'

const { newerPost, olderPost, parentPost } = Astro.props
const isSubpost = !!parentPost

const cards = [
  {
    post: olderPost,
    label: isSubpost ? '← previous subpost' : '← older',
    empty: isSubpost ? 'No older subpost' : 'You’re at the oldest post',
    align: 'items-start text-left',
  },
  ...(isSubpost
    ? [
        {
          post: parentPost,
          label: '↑ parent post',
          empty: 'No parent post',
          align: 'items-center text-center',
        },
      ]
    : []),
  {
    post: newerPost,
    label: isSubpost ? 'next subpost →' : 'newer →',
    empty: isSubpost ? 'No newer subpost' : 'You’re at the newest post',
    align: 'items-end text-right',
  },
]
---

<nav
  class={cn(
    'col-start-2 grid grid-cols-1 gap-3',
    isSubpost ? 'sm:grid-cols-3' : 'sm:grid-cols-2',
  )}
  aria-label="More posts"
>
  {
    cards.map(({ post, label, empty, align }) =>
      post ? (
        <a
          href={`/blog/${post.id}/#post-title`}
          data-internal-link="true"
          class={cn(
            'group border-border bg-surface hover:border-strong flex flex-col gap-1.5 rounded-2xl border px-4 py-3.5 transition-colors',
            align,
          )}
        >
          <span class="text-faint font-mono text-[11.5px] tracking-normal">
            {label}
          </span>
          <span class="text-foreground group-hover:text-primary text-sm leading-snug font-medium text-balance transition-colors">
            {post.data.title}
          </span>
        </a>
      ) : (
        <div
          class={cn(
            'border-border flex flex-col gap-1.5 rounded-2xl border border-dashed px-4 py-3.5',
            align,
          )}
          aria-disabled="true"
        >
          <span class="text-faint font-mono text-[11.5px] tracking-normal">
            {label}
          </span>
          <span class="text-faint text-sm">{empty}</span>
        </div>
      ),
    )
  }
</nav>
