---
import BlogCard from '@/components/BlogCard.astro'
import { getRelatedPosts } from '@/lib/data-utils'

interface Props {
  postId: string
}

const { postId } = Astro.props
const relatedPosts = await getRelatedPosts(postId, 3)
---

{
  relatedPosts.length > 0 && (
    <section
      class="col-start-2 mt-6 flex flex-col"
      aria-labelledby="related-posts"
    >
      <div class="mb-2 flex items-center gap-3.5 font-mono text-xs tracking-normal">
        <h2 id="related-posts" class="text-faint m-0 font-normal">
          <span class="text-primary">→</span> / related
        </h2>
        <span class="bg-border h-px flex-1" />
      </div>
      <ul class="divide-border m-0 flex list-none flex-col divide-y p-0">
        {relatedPosts.map((post) => (
          <li>
            <BlogCard entry={post} />
          </li>
        ))}
      </ul>
    </section>
  )
}
