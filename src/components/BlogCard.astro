---
import { getPostReadingTime } from '@/lib/data-utils'
import { getPostTopic, shortReadTime, topicColor } from '@/lib/topics'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const topic = getPostTopic(entry)
const readTime = shortReadTime(await getPostReadingTime(entry.id))
const date = entry.data.date.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
})
---

<a
  href={`/${entry.collection}/${entry.id}/`}
  data-internal-link="true"
  class="group flex flex-col gap-[5px] py-3.5"
>
  <span class="text-faint font-mono text-[11.5px] tracking-normal">
    <time datetime={entry.data.date.toISOString()}>{date}</time> ·
    <span style={`color: ${topicColor(topic)}`}>{topic}</span> · {readTime}
  </span>
  <h3
    class="text-foreground group-hover:text-primary m-0 text-[16.5px] leading-[1.4] font-medium tracking-[-0.012em] transition-colors"
  >
    {entry.data.title}
  </h3>
  <p
    class="text-muted-foreground m-0 line-clamp-1 text-[13.5px] leading-normal"
  >
    {entry.data.description}
  </p>
</a>
